# JSON resources and their reviewed inputs are bound by byte-level SHA-256.
# Preserve their original bytes on Windows and Linux checkouts.
*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol

# These files are executed or parsed by Linux release runners.
gradlew text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf
*.bat text eol=crlf
